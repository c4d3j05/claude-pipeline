# claude-pipeline dispatcher configuration.
# Copy to `.env` and fill in. The dispatcher loads this file on startup.

# --- Vikunja (the queue; source of truth) ---
# Base API URL, INCLUDING the /api/v1 suffix.
VIKUNJA_URL=https://stalwart-swine.pikapod.net/api/v1
VIKUNJA_API_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Vikunja project whose Kanban board the pipeline watches.
VIKUNJA_PROJECT_ID=

# Label that marks a task as eligible for the pipeline.
CLAUDE_LABEL=claude

# Kanban bucket names. State is signalled by bucket moves.
BUCKET_READY=Ready
BUCKET_IN_PROGRESS=In Progress
BUCKET_REVIEW=Review
BUCKET_DONE=Done
BUCKET_BLOCKED=Blocked

# --- Target repo (the code the workers change) ---
# Absolute path to a git repo that has been prepared for the pipeline
# (CLAUDE.md, .ntreerc, .claude/worker-settings.json, NTREE_WORKSPACE-aware DB naming).
TARGET_REPO_PATH=~/code/finops
# Base branch PRs target and worktrees fork from.
BASE_BRANCH=main
# GitHub label applied to every PR the pipeline opens.
PR_LABEL=claude-worker

# The gate's test command, run via `ntree run <slug> -- <TEST_CMD>` inside the worktree.
# Must match the Stop hook in the target repo's worker-settings.json.
TEST_CMD=uv run pytest -x -q

# --- Workers ---
# Test gates are CPU/DB heavy; size MAX_WORKERS to the machine (a 2-core box: 1-2).
MAX_WORKERS=2
# At most this many test gates run at once (others queue); each is cut off after GATE_TIMEOUT_MIN.
MAX_GATES=1
GATE_TIMEOUT_MIN=30
# Retries (with backoff) for transient API/network errors before a task is blocked.
TRANSIENT_RETRIES=2
# Run the gate once per base commit before spending on a worker, so a red base
# (broken environment) blocks the task for free instead of a worker "fixing" it.
BASELINE_CHECK=true
POLL_INTERVAL=60
MAX_TURNS=60
# A worker that hits MAX_TURNS with work in progress is resumed (same session, fresh turns)
# up to this many times before the task is blocked. A blocked-on-cap task that is re-queued
# resumes its workspace instead of starting over.
MAX_CONTINUATIONS=2
# The reviewer reads the diff and verifies claims; its turn budget grows with the diff size
# (10 turns + 1 per 10k chars) up to this cap. If it still runs out it is asked for a verdict.
REVIEW_MAX_TURNS=30
WALL_CLOCK_LIMIT_MIN=45
MAX_TEST_RETRIES=2
MAX_REVIEW_RETRIES=1

# Models. The worker writes the code; the review runs a cheaper model.
WORKER_MODEL=claude-opus-4-8
REVIEW_MODEL=claude-sonnet-4-6

# Worker permission mode. `auto` = the server-side classifier auto-approves ordinary
# reads/edits/commands and blocks destructive ones; the `permissions.deny` list is a
# hard backstop in every mode. Use `auto` for unattended runs. (`acceptEdits` only
# auto-approves edits and still prompts for reads/Bash — which become denials headless.)
# Review always runs read-only (`plan`).
PERMISSION_MODE=auto

# --- Budget ---
DAILY_CAP_USD=50
# Hard cap on ONE task's total spend (worker + retries + review). Hit -> blocked.
# 0 disables. Resets when a blocked task is re-queued.
TASK_CAP_USD=10

# --- Notifications ---
# Slack incoming-webhook URL for the #claude-workers channel. Leave blank to disable.
SLACK_WEBHOOK_URL=
# The claude-planner Slack app's bot token (xoxb-...). With it, events of tasks the planner filed
# (PR opened, blocked, merged, PR needs attention) are posted into that task's planner thread;
# the webhook stays the fallback. Never passed to workers, test gates, git or gh.
SLACK_BOT_TOKEN=

# --- Housekeeping ---
# Blocked tasks keep their worktree for debugging; the nightly job removes them
# (worktree, branch, DB) after this many days. Re-queue before then to retry.
BLOCKED_RETENTION_DAYS=7
# Per-task session logs under logs/ are deleted this many days after the task finishes.
LOG_RETENTION_DAYS=30
# Per-workspace database dropped on teardown. {slug} has '-' replaced by '_'.
DB_NAME_TEMPLATE=app_{slug}

# --- Credentials for workers ---
# Every subprocess (claude, gh, git, ntree) gets the variables in ~/.worker.env, re-read
# for each task (override the path with WORKER_ENV_FILE in the process environment).
# Typically: CLAUDE_CODE_OAUTH_TOKEN (claude login for headless runs) and GH_TOKEN.

# --- Paths ---
# SQLite ledger (restart recovery + cost). Defaults to ./pipeline.db
PIPELINE_DB=pipeline.db
LOG_LEVEL=INFO
